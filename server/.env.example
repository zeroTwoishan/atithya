# Atithya backend — copy to .env and fill in. Never commit .env (see .gitignore).
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Postgres 16 + pgvector — see docker-compose.yml at the repo root
DATABASE_URL=postgresql://atithya:atithya@localhost:5432/atithya

# HS256 signing key for the 3 demo role tokens (docs/TRD.md §4)
JWT_SECRET=change-me-before-demo-day

# LLM — set ONE of these. First key found wins; LLM_PROVIDER forces a choice
# (anthropic | gemini | groq) and LLM_MODEL overrides the default model.
# Gemini and Groq both have a free tier that needs no card.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# WhatsApp Cloud API (Meta) — docs/TRD.md §3.1
# APP_SECRET verifies X-Hub-Signature-256 on inbound webhooks; VERIFY_TOKEN is
# the string you type into the Meta console when subscribing the callback URL.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
